# Copy this file to .env on the server. Never put these values in VITE_* variables.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Set exactly one sender option:
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Keep this directory on persistent storage in production.
TILA_DB_PATH=./data/tila.sqlite
PORT=5173
NODE_ENV=development
# Set to true only when the app is behind a trusted reverse proxy.
TRUST_PROXY=false
